{
  "name": "call-approval-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo managing the fraud call approval frontend and backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "node --import tsx --test test/*.test.mjs",
    "lint": "npm run lint --workspace frontend",
    "start:backend": "npm start --workspace backend"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
