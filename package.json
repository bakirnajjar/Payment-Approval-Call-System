{
  "name": "call-approval-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo managing the fraud call approval frontend and backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "start:backend": "npm start --workspace backend"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.11",
    "@rollup/rollup-linux-x64-gnu": "4.64.12",
    "@swc/core-linux-x64-gnu": "1.13.21",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.16",
    "lightningcss-linux-x64-gnu": "1.30.2"
  }
}
